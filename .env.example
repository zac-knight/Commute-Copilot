# Copy to .env (git-ignored) if you need to override defaults. No API keys are required:
# the LLM is a local Ollama server and the transit/weather feeds are public.

# Demo mode: frozen fixtures + fake calendar, no real data needed.
DEMO=0

# OLLAMA_BASE_URL=http://localhost:11434
# NUM_CTX=8192
# MAX_REQUEST_TOKENS=100000
# MAX_REQUEST_SECONDS=120
# MAX_AGENT_STEPS=6
# FRONTEND_ORIGIN=http://localhost:5173
